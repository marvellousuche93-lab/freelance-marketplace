# ------------------------------------------------------------------
# Email
# ------------------------------------------------------------------
# In development, leave EMAIL_BACKEND unset â€” Django prints emails to
# the terminal where runserver is running. In production, set these to
# your SMTP service (SendGrid, Mailgun, Postmark, Gmail, etc.).
#
# Example for Gmail SMTP:
  EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
  EMAIL_HOST=smtp.gmail.com
  EMAIL_PORT=587
  EMAIL_HOST_USER=ireboyofficialtech@gmail.com
  EMAIL_HOST_PASSWORD=hmlu jhln ynpr kvip
  EMAIL_USE_TLS=True
  DEFAULT_FROM_EMAIL=Freelance Marketplace <ireboyofficialtech@gmail.com>

# The public URL of the frontend. Used to build reset links.
