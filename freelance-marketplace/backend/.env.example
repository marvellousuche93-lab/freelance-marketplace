# ------------------------------------------------------------------
# Freelance Marketplace — Backend Environment Template
# ------------------------------------------------------------------
# Copy this file to ".env" and fill in real values:
#   PowerShell:  Copy-Item .env.example .env
# NEVER commit the real .env file to Git.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Django core
# ------------------------------------------------------------------
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
DJANGO_ENV=dev
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# In development, SQLite works fine. DATABASE_URL is ignored by the
# current settings file, but production platforms set it.
DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------
# CORS — origins allowed to call this API from a browser
# ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------
# JWT token lifetimes (minutes / days)
# ------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------
# Email
# ------------------------------------------------------------------
# Leave EMAIL_BACKEND unset in development — Django prints emails to
# the runserver terminal. In production, set these to your SMTP service.
#
# Example for Gmail:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=Freelance Marketplace <you@gmail.com>

# ------------------------------------------------------------------
# Frontend URL — used to build email confirmation links
# ------------------------------------------------------------------
# Development:
FRONTEND_URL=http://localhost:5173
# Production: replace with your domain, e.g. https://example.com

# ------------------------------------------------------------------
# Token lifetimes for email-change and password-reset links
# ------------------------------------------------------------------
EMAIL_CHANGE_TOKEN_LIFETIME_HOURS=24
PASSWORD_RESET_TOKEN_LIFETIME_HOURS=2