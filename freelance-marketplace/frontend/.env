# ------------------------------------------------------------------
# Freelance Marketplace — Frontend Environment (development)
# ------------------------------------------------------------------

VITE_API_URL=/api

# Public base URL used for canonical links and JSON-LD @id fields.
VITE_SITE_URL=http://localhost:5173

# Development-only: adds artificial latency to every API call so
# loading states are visible while developing.
#
#   0     — off (fast, loaders may flash too quickly to see)
#   600   — pleasant; loaders visibly animate
#   1500  — clearly shows every loader
#
# Set to 0 (or remove) before deploying.
VITE_FAKE_LATENCY_MS=3000